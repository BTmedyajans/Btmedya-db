node_modules/
.wrangler/
.dryrun/
*.log

# Yerel gelistirme sirlari — asla depoya girmemeli.
# wrangler dev bu dosyayi otomatik okur; ADMIN_PASSWORD, ADMIN_SESSION_SECRET,
# META_ACCESS_TOKEN gibi gercek degerler burada tutulur. Uretim sirlari
# "wrangler secret put" veya panelden girilir, dosyaya yazilmaz.
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Python onbellek klasoru: tools/paylasim-kapagi.py, haber-kapagi.py modulunu
# import ettigi icin olusuyor; depoya girmez.
__pycache__/

# Android yerel derleme ve imzalama çıktıları — depoya girmez.
android-admin/.gradle/
android-admin/app/build/
android-admin/*.jks
android-admin/*.keystore
android-admin/keystore.properties
dist/
